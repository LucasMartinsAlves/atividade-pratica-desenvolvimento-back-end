            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Criado\", () => pm.response.to.have.status(201));",
